# Canonical site URL (metadata, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Supabase project (Project Settings -> API). The anon key is public by design;
# the site only ever reads through it, protected by RLS read-only policies.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Shared secret for POST/GET /api/revalidate (Supabase Database Webhooks).
REVALIDATE_SECRET=change-me-to-a-long-random-string
